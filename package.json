{
  "name": "rikaz",
  "private": true,
  "version": "2.0.0",
  "description": "منظومة ركاز لإدارة المقاولات والتشطيبات",
  "author": "شركة ركاز العقارية",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "desktop:start": "electron .",
    "desktop:build": "npm run build && electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "ly.rikaz.app",
    "productName": "ركاز",
    "executableName": "Rikaz",
    "artifactName": "Rikaz-Setup-${version}.${ext}",
    "copyright": "© 2026 شركة ركاز العقارية",
    "directories": {
      "output": "../rikaz-release",
      "buildResources": "desktop"
    },
    "files": [
      "dist/**/*",
      "desktop/main.cjs",
      "desktop/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ركاز",
      "uninstallDisplayName": "ركاز"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.3",
    "lucide-react": "^1.57.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5"
  }
}
